{
  "name": "@polyhymnia/notation-fonts",
  "version": "0.2.0",
  "description": "SMuFL music notation fonts and glyph tables for @polyhymnia/notation-engine, with @font-face CSS helpers.",
  "keywords": [
    "smufl",
    "music",
    "notation",
    "font"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "font:build": "node scripts/build.mjs",
    "font:add": "node scripts/add.mjs",
    "font:verify": "node scripts/verify.mjs",
    "font:sync": "node scripts/sync.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/notation.git",
    "directory": "packages/notation-fonts"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/adrian729/notation/tree/master/packages/notation-fonts#readme",
  "bugs": {
    "url": "https://github.com/adrian729/notation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
