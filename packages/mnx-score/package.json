{
  "name": "@polyhymnia/mnx-score",
  "version": "0.3.1",
  "description": "Musical timeline over MNX documents: ticks, stable ids, pitch to MIDI, ties, tempo, play order and performance events.",
  "keywords": [
    "mnx",
    "music",
    "timeline",
    "playback",
    "midi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@polyhymnia/mnx": "workspace:*",
    "@polyhymnia/music-theory": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/notation.git",
    "directory": "packages/mnx-score"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/adrian729/notation/tree/master/packages/mnx-score#readme",
  "bugs": {
    "url": "https://github.com/adrian729/notation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
