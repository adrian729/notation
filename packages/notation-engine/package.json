{
  "name": "@polyhymnia/notation-engine",
  "version": "0.1.0",
  "description": "Renderer-agnostic music engraving for MNX: layout, glyph positions, hit-testing and playback cursor positions. No DOM.",
  "keywords": [
    "mnx",
    "music",
    "notation",
    "engraving",
    "layout",
    "smufl"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@polyhymnia/mnx": "workspace:*",
    "@polyhymnia/mnx-score": "workspace:*",
    "@polyhymnia/music-theory": "^0.1.0",
    "@polyhymnia/notation-fonts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ajv": "8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/notation.git",
    "directory": "packages/notation-engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/adrian729/notation/tree/master/packages/notation-engine#readme",
  "bugs": {
    "url": "https://github.com/adrian729/notation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
