{
  "name": "@polyhymnia/mnx",
  "version": "0.1.0",
  "description": "MNX (W3C) score format: pinned schema, generated types, readMnx, rational time, scoped element ids and applyIntent edits.",
  "keywords": [
    "mnx",
    "music",
    "notation",
    "score",
    "w3c"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./edit": "./dist/edit/index.js",
    "./schema": "./schema/mnx-schema.json"
  },
  "files": [
    "dist",
    "schema/mnx-schema.json",
    "schema/SOURCE",
    "schema/NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "mnx:update": "node scripts/mnx-update.mjs",
    "gen:mnx-types": "node scripts/gen-mnx-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ajv": "8.20.0",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/notation.git",
    "directory": "packages/mnx"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/adrian729/notation/tree/master/packages/mnx#readme",
  "bugs": {
    "url": "https://github.com/adrian729/notation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
