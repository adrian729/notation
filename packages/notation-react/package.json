{
  "name": "@polyhymnia/notation-react",
  "version": "0.1.0",
  "description": "React SVG renderer for MNX scores laid out by @polyhymnia/notation-engine, with interaction, marks and playback highlighting.",
  "keywords": [
    "mnx",
    "music",
    "notation",
    "react",
    "svg",
    "sheet-music"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./styles/notation.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@polyhymnia/mnx": "workspace:*",
    "@polyhymnia/mnx-score": "workspace:*",
    "@polyhymnia/notation-engine": "workspace:*",
    "@polyhymnia/notation-fonts": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "files": [
    "dist",
    "styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/notation.git",
    "directory": "packages/notation-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/adrian729/notation/tree/master/packages/notation-react#readme",
  "bugs": {
    "url": "https://github.com/adrian729/notation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
