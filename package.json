{
  "name": "notation-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "test": "pnpm -r --filter=./packages/* test",
    "dev": "pnpm --filter @polyhymnia/web dev",
    "mnx:update": "pnpm --filter @polyhymnia/mnx mnx:update",
    "font:add": "pnpm --filter @polyhymnia/notation-fonts font:add",
    "font:verify": "pnpm --filter @polyhymnia/notation-fonts font:verify"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.7.0"
  }
}
